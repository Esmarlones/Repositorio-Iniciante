class ArrayList:
    def __init__(self):
        self.MEMORY_SPACE = 10
        self.lastPosition = 0
        self.array = [] * self.MEMORY_SPACE

    def get(self, position: int):
        if position < 0 or position > (self.size() - 1):
            raise IndexError("Indice fora dos limites da lista")
        return self.array[position]

    def updateRemoveArray(self, start: int, end: int):
        for index in range(start, end):
            self.array[index] = self.array[index + 1]
        self.array[self.lastPosition - 1] = None
        self.lastPosition -= 1

    def updateInsertArray(self, start: int, end: int):
        for index in range(start, end, -1):
            self.array[index] = self.array[index - 1]
        self.lastPosition += 1

    def removeAll(self):
        self.array = [None] * self.capacity()
        self.lastPosition = 0

    def add(self, value):
        if self.lastPosition == self.capacity():
            self.resizeMemory()
        self.array[self.lastPosition] = value
        self.lastPosition += 1

    def insertAt(self, value, position: int):
        if position < 0 or position > self.lastPosition:
            raise IndexError("Indice fora dos limites da lista")
        if self.lastPosition == self.capacity():
            self.resizeMemory()
        self.updateInsertArray(self.lastPosition, position)
        self.array[position] = value

    def removeAt(self, position: int):
        if position < 0 or position > (self.size() - 1):
            raise IndexError("Indice fora dos limites da lista")
        copy = self.array[position]
        self.updateRemoveArray(position, self.size() - 1)
        return copy

    def remove(self):
        if self.size() == 0:
            raise IndexError("Indice fora dos limites da lista")
        last = self.array[self.lastPosition - 1]
        self.array[self.lastPosition - 1] = None
        self.lastPosition -= 1
        return last

    def capacity(self):
        return len(self.array)

    def size(self):
        return self.lastPosition

    def print(self):
        for position in range(0, self.lastPosition):
            print(self.array[position])

    def resizeMemory(self):
        print("Aumentando memoria da ArrayList")
        newArray = [None] * (self.capacity() * 2)
        for position in range(self.capacity()):
            newArray[position] = self.array[position]
        self.array = newArray


def register_contact(contact_book):
    print("\n=== CADASTRAR CONTATO ===")
    name = input("Nome: ")
    phone = input("Telefone: ")

    contact = {
        "name": name,
        "phone": phone
    }

    contact_book.add(contact)
    print("Contato cadastrado com sucesso!")


def list_contacts(contact_book):
    print("\n=== LISTA DE CONTATOS ===")

    if contact_book.size() == 0:
        print("Nenhum contato cadastrado.")
        return

    for position in range(contact_book.size()):
        contact = contact_book.get(position)
        print(f"{position + 1}. Nome: {contact['name']} | Telefone: {contact['phone']}")


def search_contact(contact_book):
    print("\n=== BUSCAR CONTATO ===")
    searched_name = input("Digite o nome que deseja buscar: ")
    found = False

    for position in range(contact_book.size()):
        contact = contact_book.get(position)

        if contact["name"].lower() == searched_name.lower():
            print(f"Contato encontrado: {contact['name']} - {contact['phone']}")
            found = True

    if not found:
        print("Contato nao encontrado.")


def delete_contact(contact_book):
    print("\n=== REMOVER CONTATO ===")
    list_contacts(contact_book)

    if contact_book.size() == 0:
        return

    number = int(input("Digite o numero do contato que deseja remover: "))
    position = number - 1

    if position >= 0 and position < contact_book.size():
        contact_book.removeAt(position)
        print("Contato removido com sucesso!")
    else:
        print("Opcao invalida.")


def show_menu():
    print("\n===== AGENDA TELEFONICA =====")
    print("1. Cadastrar contato")
    print("2. Listar contatos")
    print("3. Buscar contato")
    print("4. Remover contato")
    print("5. Sair")


def main():
    contact_book = ArrayList()

    while True:
        show_menu()
        option = input("Escolha uma opcao: ")

        if option == "1":
            register_contact(contact_book)
        elif option == "2":
            list_contacts(contact_book)
        elif option == "3":
            search_contact(contact_book)
        elif option == "4":
            delete_contact(contact_book)
        elif option == "5":
            print("Programa finalizado.")
            break
        else:
            print("Opcao invalida.")


if __name__ == "__main__":
    main()
